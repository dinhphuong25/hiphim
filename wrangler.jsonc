{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hiphim-updates",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-02-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"routes": [
		{
			"pattern": "hiphim.one",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "HIPHIM_DB",
			"database_name": "hiphim-users",
			"database_id": "084c7ac4-eca8-4c6d-92db-f176b86a4268"
		}
	],
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "hiphim-updates"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"vars": {
		"EMAIL_FROM": "Hi Phim <notification@hiphim.one>",
		"NEXT_PUBLIC_APP_URL": "https://hiphim.one",
		"USER_JWT_SECRET": "hiphim_user_jwt_secret_key_2026_super_secure",
		"ADMIN_JWT_SECRET": "hiphim_admin_jwt_secret_key_2026_super_secure",
		"GMAIL_USER": "notification.hiphim@gmail.com"
	}
}
