{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hiphim-updates",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-02-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "HIPHIM_DB",
			"database_name": "hiphim-users",
			"database_id": "084c7ac4-eca8-4c6d-92db-f176b86a4268"
		}
	],
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "hiphim-updates"
		}
	],
	"images": {
		"binding": "IMAGES"
	}
}
